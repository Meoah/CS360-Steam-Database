></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">--This selects games price in ascending order.
SELECT * FROM game 
Order by price ASC 

--How many publishers and how many games are under those publishers.
SELECT count(*)
FROM published_games

--Select achievements in ascending order by achievemeny obtained


--Select and display game name and byte size and sort by descending order


--Join query - Select game by transaction and display username, game name, transction id, and price
SELECT steam_accounts.user_id, game.title, transactions.transaction_id, game.price
FROM steam_accounts
INNER JOIN game ON game.game_id = transactions.game_id</sql><current_tab id="0"/></tab_sql></sqlb_project>
